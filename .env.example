# Copy this file to `.env` for local development.
# Both values are public (they ship in the browser bundle) — never put the
# Supabase service_role key here.
#
# Find them in your Supabase project: Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Either key format works: classic anon (eyJhbGciOi...) or a newer publishable
# key (sb_publishable_...).
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Leave these empty to run in local demo mode (messages stay in the browser).
