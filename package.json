{
  "name": "chatter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chatter — WhatsApp-style chat with username/password sign-in and QR-code contact exchange (no phone numbers).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "serve:subpath": "node tests/serve-subpath.mjs",
    "setup:browser": "node tests/setup-browser-libs.mjs",
    "pretest:e2e": "npm run setup:browser && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "html5-qrcode": "^2.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
